#Область ОбработчикиСобытий

// Проверяет заполнение обязательных реквизитов документа и наличие строк в табличной части
// "Товары". Выводит сообщения пользователю с привязкой к незаполненным полям.
//
// Параметры:
//  Отказ - Булево - устанавливается в Истина, если обнаружены незаполненные реквизиты.
//  ПроверяемыеРеквизиты - Массив из Строка - имена реквизитов, подлежащих проверке.
//                         Не используется: проверяется весь состав реквизитов документа.
//
Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)

	Если НЕ ЗначениеЗаполнено(Контрагент) Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = НСтр("ru = 'Не заполнен контрагент.'");
		Сообщение.Поле = "Контрагент";
		Сообщение.Сообщить();
		Отказ = Истина;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Склад) Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = НСтр("ru = 'Не заполнен склад.'");
		Сообщение.Поле = "Склад";
		Сообщение.Сообщить();
		Отказ = Истина;
	КонецЕсли;

	Если Товары.Количество() = 0 Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = НСтр("ru = 'Табличная часть Товары не заполнена.'");
		Сообщение.Поле = "Товары";
		Сообщение.Сообщить();
		Отказ = Истина;
	КонецЕсли;

	Для Каждого СтрокаТовары Из Товары Цикл
		Если НЕ ЗначениеЗаполнено(СтрокаТовары.Номенклатура) Тогда
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = НСтр("ru = 'В строке %1 не заполнена номенклатура.'");
			Сообщение.Текст = СтрШаблон(Сообщение.Текст, СтрокаТовары.НомерСтроки);
			Сообщение.Поле = "Товары[" + (СтрокаТовары.НомерСтроки - 1) + "].Номенклатура";
			Сообщение.Сообщить();
			Отказ = Истина;
		КонецЕсли;

		Если СтрокаТовары.Количество <= 0 Тогда
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = НСтр("ru = 'В строке %1 количество должно быть больше нуля.'");
			Сообщение.Текст = СтрШаблон(Сообщение.Текст, СтрокаТовары.НомерСтроки);
			Сообщение.Поле = "Товары[" + (СтрокаТовары.НомерСтроки - 1) + "].Количество";
			Сообщение.Сообщить();
			Отказ = Истина;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Рассчитывает суммы по строкам табличной части "Товары" и итоговую сумму документа.
//
// Параметры:
//  Отказ - Булево - устанавливается в Истина при отказе от записи документа.
//  РежимЗаписи - РежимЗаписиДокумента - режим записи документа.
//  РежимПроведения - РежимПроведенияДокумента - режим проведения документа.
//
Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	СуммаДокумента = 0;

	Для Каждого СтрокаТовары Из Товары Цикл
		СтрокаТовары.Сумма = СтрокаТовары.Количество * СтрокаТовары.Цена;
		СуммаДокумента = СуммаДокумента + СтрокаТовары.Сумма;
	КонецЦикла;

КонецПроцедуры

// Формирует движения расхода по регистру накопления "ОстаткиТоваров" по строкам
// табличной части "Товары" и контролирует отсутствие отрицательных остатков.
//
// Параметры:
//  Отказ - Булево - устанавливается в Истина, если остатков недостаточно для списания.
//  РежимПроведения - РежимПроведенияДокумента - режим проведения документа.
//
Процедура ОбработкаПроведения(Отказ, РежимПроведения)

	Движения.ОстаткиТоваров.Записывать = Истина;

	Для Каждого СтрокаТовары Из Товары Цикл
		Движение = Движения.ОстаткиТоваров.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
		Движение.Период = Дата;
		Движение.Номенклатура = СтрокаТовары.Номенклатура;
		Движение.Склад = Склад;
		Движение.Количество = СтрокаТовары.Количество;
	КонецЦикла;

	Если ЕстьНедостаточныеОстатки() Тогда
		Отказ = Истина;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Проверяет, хватает ли остатков на складе документа для списания всех товаров.
// Остатки сопоставляются с количеством из табличной части с учетом текущего документа
// и выводит сообщение пользователю по каждой позиции, которой не хватает.
//
// Возвращаемое значение:
//  Булево - Истина, если хотя бы по одной позиции остатка недостаточно.
//
Функция ЕстьНедостаточныеОстатки()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТоварыДокумента.Номенклатура КАК Номенклатура,
	|	ТоварыДокумента.Количество КАК Количество,
	|	ЕСТЬNULL(ОстаткиТоваровОстатки.КоличествоОстаток, 0) КАК Остаток
	|ИЗ
	|	(ВЫБРАТЬ
	|		Товары.Номенклатура КАК Номенклатура,
	|		СУММА(Товары.Количество) КАК Количество
	|	ИЗ
	|		Документ.РасходнаяНакладная.Товары КАК Товары
	|	ГДЕ
	|		Товары.Ссылка = &Ссылка
	|	СГРУППИРОВАТЬ ПО
	|		Товары.Номенклатура) КАК ТоварыДокумента
	|		ЛЕВОЕ СОЕДИНЕНИЕ
	|			РегистрНакопления.ОстаткиТоваров.Остатки(&ГраницаМомента, Склад = &Склад)
	|				КАК ОстаткиТоваровОстатки
	|		ПО ТоварыДокумента.Номенклатура = ОстаткиТоваровОстатки.Номенклатура
	|ГДЕ
	|	ТоварыДокумента.Количество > ЕСТЬNULL(ОстаткиТоваровОстатки.КоличествоОстаток, 0)";

	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.УстановитьПараметр("Склад", Склад);
	Запрос.УстановитьПараметр("ГраницаМомента", Новый Граница(МоментВремени(), ВидГраницы.Исключая));

	Результат = Запрос.Выполнить().Выбрать();
	ЕстьНедостаток = Ложь;

	Пока Результат.Следующий() Цикл
		ЕстьНедостаток = Истина;
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = СтрШаблон(
			НСтр("ru = 'Недостаточно товара %1: остаток %2, требуется %3.'"),
			Результат.Номенклатура,
			Результат.Остаток,
			Результат.Количество);
		Сообщение.Сообщить();
	КонецЦикла;

	Возврат ЕстьНедостаток;

КонецФункции

#КонецОбласти
